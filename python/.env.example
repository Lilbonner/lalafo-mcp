# Country: 12 = Kyrgyzstan, 13 = Azerbaijan, 14 = Poland
LALAFO_COUNTRY_ID=12
LALAFO_LANGUAGE=ru

# Lalafo's price filter is currency-blind, so car prices are normalized to USD client-side.
# Approx KGS per 1 USD (update periodically).
USD_KGS_RATE=89

# --- Subscriptions / monitor ---
# Where saved searches + seen-listing state live (shared by the server and the monitor).
# LALAFO_DATA_DIR=C:\Users\you\.lalafo-mcp
# Monitor poll interval in seconds (default 600).
# MONITOR_INTERVAL=600

# --- Notification channels (configure any subset; matches go to all that are set) ---
# NTFY_TOPIC_URL=https://ntfy.sh/my-lalafo-topic
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# WEBHOOK_URL=https://example.com/hook
